{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Bravo Hub",
  "version": "0.6.7",
  "identifier": "com.bravovisuals.hub",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Bravo Hub",
        "width": 1440,
        "height": 900,
        "minWidth": 1024,
        "minHeight": 680,
        "center": true,
        "backgroundColor": "#1d1f1a",
        "dragDropEnabled": false
      }
    ],
    "security": {
      "csp": null,
      "assetProtocol": {
        "enable": true,
        "scope": [
          "$APPLOCALDATA/media/**"
        ]
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis",
      "msi"
    ],
    "publisher": "Bravo Visuals",
    "category": "Graphics and Design",
    "shortDescription": "Hub de IAs da Bravo Visuals",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "windows": {
      "nsis": {
        "installMode": "currentUser",
        "languages": [
          "PortugueseBR"
        ]
      }
    },
    "createUpdaterArtifacts": true
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDFDRkNGNzdGRkZGRDgyMjIKUldRaWd2My9mL2Y4SFAzRUFOKytYa21CZnRhcUpGK0pFYjFZNW55SmZlVmxUajRQVDNCd1BlQUgK",
      "endpoints": [
        "https://github.com/Victorborgesa/bravo-hub/releases/latest/download/latest.json"
      ],
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
